# Parsed by Workers, never served. These cover every real page load, because
# assets.run_worker_first in wrangler.jsonc is scoped to /api/* and /r/* — so
# the Worker is not in the path for the app itself and cannot set them.
#
# worker/index.js carries the same policy for the responses it does generate
# (a malformed /api/ or /r/ path falling through to the SPA); _headers does not
# apply to those. Change one, change the other — attention.md explains which
# three allowances here are load-bearing.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
