{
  "name": "pinwall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "test:cli": "go test ./...",
    "build:cli": "go build ./cmd/pw",
    "test:worker": "node --test worker/index.test.js"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
