# Loaded by `vite dev` only (overrides .env.local; never used by `npm run build`).
#
# Cloudflare production sitekeys reject localhost and flag automation, so dev
# uses the official always-passes dummy sitekey. It emits XXXX.DUMMY.TOKEN.XXXX.
#
# Swap to test other paths:
#   2x00000000000000000000AB  always fails   -> error handling
#   3x00000000000000000000FF  forces challenge -> interactive flow
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
