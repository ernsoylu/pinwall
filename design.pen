                          "name": "Code 4",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  if (input.password) {",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "L4FtR",
                          "name": "Code 5",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    const { ciphertext, iv } = await encrypt(input.body, input.password)",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "q1YNOl",
                          "name": "Code 6",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    return submit({ id, ciphertext, iv, language: input.language })",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
