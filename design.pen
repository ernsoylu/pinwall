                          "name": "Code 6",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    return submit({ id, ciphertext, iv, language: input.language })",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
