                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "export async function createPin(input: PinInput) {",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "SerC7",
                          "name": "Code 2",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  const id = nanoid(7)",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "F9QsRG",
                          "name": "Code 3",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": " ",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "uKemV",
                          "name": "Code 4",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  if (input.password) {",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "vRoZ7",
                          "name": "Code 5",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    const { ciphertext, iv } = await encrypt(input.body, input.password)",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "jK7CL",
                          "name": "Code 6",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    return submit({ id, ciphertext, iv, language: input.language })",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "egCcl",
                          "name": "Code 7",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  }",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "VXFS7",
                          "name": "Code 8",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": " ",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
