                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "export async function createPin(input: PinInput) {",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "J9OcM1",
                          "name": "Code 2",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  const id = nanoid(7)",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "KvQNQ",
                          "name": "Code 3",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": " ",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "or4jy",
                          "name": "Code 4",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  if (input.password) {",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "QzE1j",
                          "name": "Code 5",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    const { ciphertext, iv } = await encrypt(input.body, input.password)",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "sLZrk",
                          "name": "Code 6",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    return submit({ id, ciphertext, iv, language: input.language })",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "b1lgZW",
                          "name": "Code 7",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  }",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "DWJ50",
                          "name": "Code 8",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": " ",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
