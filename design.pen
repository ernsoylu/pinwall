                          "name": "Code 4",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "  if (input.password) {",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "prghV",
                          "name": "Code 5",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "    const { ciphertext, iv } = await encrypt(input.body, input.password)",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
